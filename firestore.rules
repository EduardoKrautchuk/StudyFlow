rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidSubject(data) {
      return data.keys().hasOnly(['name', 'color', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.color is string
        && data.color.matches('^#[0-9A-Fa-f]{6}$')
        && data.createdAt is timestamp;
    }

    function isValidActivity(data) {
      return data.keys().hasOnly([
          'title', 'description', 'subjectId', 'type', 'priority',
          'status', 'dueDate', 'dueTime', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() <= 1000
        && data.subjectId is string
        && data.subjectId.size() > 0
        && data.type in ['exam', 'assignment', 'task']
        && data.priority in ['low', 'medium', 'high']
        && data.status in ['pending', 'completed']
        && data.dueDate is string
        && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.dueTime == null || (data.dueTime is string && data.dueTime.matches('^[0-2][0-9]:[0-5][0-9]$')))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/subjects/{subjectId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidSubject(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidSubject(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId}/activities/{activityId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidActivity(request.resource.data)
        && exists(/databases/$(database)/documents/users/$(userId)/subjects/$(request.resource.data.subjectId))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidActivity(request.resource.data)
        && exists(/databases/$(database)/documents/users/$(userId)/subjects/$(request.resource.data.subjectId))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
